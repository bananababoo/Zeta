# Rust build output. Cargo.lock is committed, because the workspace builds binaries.
/target/

# Secrets and local configuration. AI provider keys and database passwords live here, never in the repository.
.env
.env.*
!.env.example
*.local.toml

# Local database data from Docker.
/.data/

# Obsidian: shared vault settings are committed, per-person window layout and cache are not.
.obsidian/workspace.json
.obsidian/workspace-mobile.json
.obsidian/cache
.trash/

# Editors.
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/
*.swp
*~

# Operating system files.
.DS_Store
Thumbs.db
desktop.ini

# Logs and crash dumps.
*.log
*.pdb

# Local bulk visual asset library (imported from Google Drive; too large for git).
/assets/library/
/maptools*.zip

# Python bytecode.
**/__pycache__/
