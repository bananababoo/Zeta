# Copy this file to `.env` and fill in the values. `.env` is ignored by git; never commit secrets.

# AI provider and model. Switching either is a change here, never in code.
# Supported providers: gemini
ZETA_AI_PROVIDER=gemini
# Free on the Gemini free tier: gemini-3.5-flash-lite (fast, higher daily caps) or
# gemini-4-hydrogen (smarter, low daily cap). Check your caps at
# https://aistudio.google.com/rate-limit
ZETA_AI_MODEL=gemini-3.5-flash-lite

# Gemini API key. Create one at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Local PostgreSQL started by compose.yaml.
POSTGRES_USER=zeta
POSTGRES_PASSWORD=change-me
POSTGRES_DB=zeta
POSTGRES_PORT=5432
