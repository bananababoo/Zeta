# Copy this file to `.env` and fill in the values. `.env` is ignored by git; never commit secrets.

# AI provider: Gemini API free tier. Create a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Model name as listed in Google AI Studio. Pick a Flash model that the free tier includes.
ZETA_AI_MODEL=gemini-2.5-flash

# Local PostgreSQL started by compose.yaml.
POSTGRES_USER=zeta
POSTGRES_PASSWORD=change-me
POSTGRES_DB=zeta
POSTGRES_PORT=5432
